# ==========================================
# Brentra Ventures — Environment Configuration
# ==========================================

# Server & Runtime
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://bentra-ventures.vercel.app

# Database (Supabase PostgreSQL Tokyo)
# Provide either DATABASE_URL or individual DB_* parameters
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-id
DB_PASSWORD=your-secure-password
DB_NAME=postgres
DB_SSL=true

# Supabase Client API Keys
VITE_SUPABASE_URL=https://cqejrdwdddelpdlizbih.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://cqejrdwdddelpdlizbih.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Admin Authentication
ADMIN_API_KEY=your-secure-admin-api-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
OTP_SALT=your-secure-random-otp-salt

# Bot Check & Security (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=0x4AAAAAA...
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

# Frontend API Endpoint
VITE_API_URL=https://bentra-ventures.onrender.com
